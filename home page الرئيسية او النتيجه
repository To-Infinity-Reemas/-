      child: Padding(
        padding: const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(
              "هل يوجد انتحال؟ ${_result!['plagiarism'] ? 'نعم' : 'لا'}",
              style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 18),
            ),
            const Divider(),
            const Text(
              "أفضل التوقعات:",
              style: TextStyle(fontWeight: FontWeight.bold),
            ),
            ...(_result!['predictions'] as List).map((p) {
              return Text(
                "- ${artStyleTranslations[p['label']] ?? p['label']} (${p['confidence']}%)",
              );
