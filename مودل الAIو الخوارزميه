normalized_label_index = {key.lower().strip(): value for key, value in label_index.items()}

def create_df(base):
    dd = {"images": [], "labels": []}
    
    for i in os.listdir(base):
        label_dir = os.path.join(base, i)
        
        if not os.path.isdir(label_dir):
            continue
        
        normalized_label = i.lower().strip()
        
        if normalized_label not in normalized_label_index:
            print(f"Warning: '{i}' not found in label_index. Skipping...")
            continue
        
        for j in os.listdir(label_dir):
            img_path = os.path.join(label_dir, j)
            
            if os.path.isfile(img_path):
                dd["images"].append(img_path)
                dd["labels"].append(normalized_label_index[normalized_label])
    
    return pd.DataFrame(dd)
