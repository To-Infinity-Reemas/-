])

def augment_dataset(input_dir, output_dir, augment_count=5):
    for category in os.listdir(input_dir):
        category_path = os.path.join(input_dir, category)

        if not os.path.isdir(category_path):
            continue
        
        images = [img for img in os.listdir(category_path) if img.lower().endswith(('.jpg', '.jpeg', '.png'))]
        
        if len(images) == 0:
            continue
        
        category_output_dir = os.path.join(output_dir, category)
        os.makedirs(category_output_dir, exist_ok=True)

        def process_images(image_list):
            for img_name in tqdm(image_list, desc=f"Processing {category}"):
                img_path = os.path.join(category_path, img_name)
                image = cv2.imread(img_path)

                if image is None:
                    continue
                
                image = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)
                
                shutil.copy(img_path, os.path.join(category_output_dir, img_name))
                
                for i in range(augment_count):
                    augmented = transform(image=image)['image']
                    augmented = cv2.cvtColor(augmented, cv2.COLOR_RGB2BGR)
                    aug_img_name = f"{img_name.split('.')[0]}_aug_{i}.jpg"
                    aug_img_path = os.path.join(category_output_dir, aug_img_name)
                    cv2.imwrite(aug_img_path, augmented)

        process_images(images)

    print("Dataset augmentation completed!")

