    train_loader = tqdm(train_dl, desc=f"Epoch {i} [Training]", leave=False)
    
    for data, target in train_loader:
        optimizer.zero_grad()
        
        if torch.cuda.is_available():
            data, target = data.cuda(), target.cuda()
            
        out = model(data)
        loss = criterion(out, target)
        
        diff += loss.item()
        acc += (out.argmax(1) == target).sum().item()
        total += target.size(0)
        
        loss.backward()
        optimizer.step()
        
        train_loader.set_postfix(loss=loss.item(), acc=acc / total)
        
    train_loss.append(diff / len(train_dl))
    train_acc.append(acc / total)
    
    model.eval()
    
    diff = 0
    total = 0
    acc = 0
    
    val_loader = tqdm(val_dl, desc=f"Epoch {i} [Validation]", leave=False)
    
    with torch.no_grad():
        for data, target in val_loader:
            if torch.cuda.is_available():
                data, target = data.cuda(), target.cuda()
                
            out = model(data)
            loss = criterion(out, target)
            diff += loss.item()
            acc += (out.argmax(1) == target).sum().item()
            total += target.size(0)
            
            val_loader.set_postfix(loss=loss.item(), acc=acc / total)
            
    val_loss.append(diff / len(val_dl))
    val_acc.append(acc / total)
    
    if val_acc[-1] > best_acc:
        best_acc = val_acc[-1]
        best_model_wts = deepcopy(model.state_dict())
        torch.save(best_model_wts, "best_model.pth")
    
    if i == EPOCHS:
        last_model_wts = deepcopy(model.state_dict())
        torch.save(last_model_wts, "last_model.pth")
    
    scheduler.step(val_loss[-1])
    
    print(f"Epoch {i}: Train Loss {train_loss[-1]:.4f}, Train Acc {train_acc[-1]:.4f}, "
          f"Val Loss {val_loss[-1]:.4f}, Val Acc {val_acc[-1]:.4f}")
    
    del data, target, out, loss
    torch.cuda.empty_cache()
    gc.collect()
                                                                                            
