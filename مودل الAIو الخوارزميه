def predict(img_path):
    img = Image.open(img_path).convert("RGB")
    img = transform(img)
    img = img.unsqueeze(0)
    img = img.to(device)
    
    with torch.no_grad():
        output = best_model(img)
        predicted_class = output.argmax(1).item()
    
    return predicted_class
